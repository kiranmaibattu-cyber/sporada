ARG INTEL_TRAFFIC_PARENT_BASE=localhost/sporada-intel-runtime-base:intel-285h-2026.08.24-v1
FROM ${INTEL_TRAFFIC_PARENT_BASE}

RUN python -c "import cv2, numpy, openvino; assert hasattr(cv2, 'estimateAffinePartial2D')" \
    && test "$(id -u apexruntime)" = "10001"

LABEL org.opencontainers.image.source="https://github.com/kiranmaibattu-cyber/sporada" \
      org.opencontainers.image.title="Sporada Secure Intel Runtime Base" \
      org.opencontainers.image.description="Intel GPU/NPU, VAAPI, OpenVINO, OpenCV, and Python runtime for traffic and face extraction" \
      org.opencontainers.image.version="intel-285h-2026.09.18-v2" \
      io.apexfabric.image.role="runtime-base" \
      io.apexfabric.solution-pack="sporada-secure" \
      io.apexfabric.hardware.profile="intel-285h"
